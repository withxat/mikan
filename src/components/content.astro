---
import { cn } from '@/lib/utils'
---

<div
	class={cn(
		'selection:bg-brand selection:text-brand-foreground relative bg-background text-foreground pt-2 pb-2 shadow flex flex-col gap-2',
	)}
	id="content"
	transition:name="content"
>
	<div
		class="absolute z-10 -top-[9px] h-2.5 w-full overflow-hidden after:content-[''] after:absolute after:top-0 after:left-0 after:h-10 after:w-full after:bg-background after:[mask-image:url('/image/decoration.svg')] after:[-webkit-mask-image:url('/image/decoration.svg')] after:[mask-repeat:repeat-x] after:[-webkit-mask-repeat:repeat-x] after:[mask-size:contain] after:[-webkit-mask-size:contain]"
	>
	</div>
	<content class="sm:w-2xl sm:mx-auto sm:border-x">
		<slot />
	</content>
</div>
