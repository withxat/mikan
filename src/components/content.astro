---
import { cn } from '@/lib/utils';
---

<div
	class={cn(
		'selection:bg-brand selection:text-brand-foreground relative bg-background text-foreground pt-2 pb-2 shadow flex flex-col gap-2',
		'opacity-0 print:opacity-100',
	)}
	id="content"
	transition:animate="none"
	transition:name="content"
>
	<div
		class="absolute z-10 -top-[9px] h-2.5 w-full overflow-hidden after:content-[''] after:absolute after:top-0 after:left-0 after:h-10 after:w-full after:bg-[url('/image/decoration.svg')] after:bg-repeat-x after:bg-contain"
	>
	</div>
	<content class="sm:w-xl sm:mx-auto sm:border-x">
		<slot />
	</content>
</div>

<script>
import { animate, spring } from 'motion'

function getViewportHeight() {
	return window.innerHeight
}

// Animate in with spring physics
document.addEventListener('astro:page-load', () => {
	const viewportHeight = getViewportHeight()
	animate(
		'#content,footer',
		{
			opacity: [0, 1],
			y: [viewportHeight, 0],
		},
		{
			delay: 0.5,
			duration: 1,
			type: spring,
		},
	)
})

// Animate out with spring physics
document.addEventListener('astro:before-preparation', () => {
	const viewportHeight = getViewportHeight()
	animate(
		'#content,footer',
		{
			opacity: [1, 0],
			y: [0, viewportHeight],
		},
		{
			duration: 0.8,
			type: spring,
		},
	)
})
</script>
