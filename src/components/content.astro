---
import { withBase } from '@/lib/urls'
import { cn } from '@/lib/utils'
---

<div
	class={cn(
		`
			relative flex flex-col gap-2 bg-background py-2 text-foreground shadow-sm
			selection:bg-brand selection:text-brand-foreground
		`,
	)}
	id="content"
	transition:name="content"
>
	<div
		class="
			absolute top-[-9px] z-10 h-2.5 w-full overflow-hidden
			after:absolute after:top-0 after:left-0 after:h-10 after:w-full after:bg-background after:mask-(--paper-edge) after:mask-contain after:mask-repeat-x after:content-['']
			after:[-webkit-mask-image:var(--paper-edge)] after:[-webkit-mask-repeat:repeat-x] after:[-webkit-mask-size:contain]
		"
		style={{ '--paper-edge': `url(${withBase('/image/decoration.svg')})` }}
	>
	</div>
	<main
		class="
			w-full max-w-2xl
			sm:mx-auto sm:border-x
		"
		id="main-content"
	>
		<slot />
	</main>
</div>
