---
import { siteConfig } from '@/site.config'

interface Props { text?: string }
const { text = siteConfig.hero } = Astro.props
---

<h1
	class="
		w-full max-w-2xl px-4 pt-4 pb-12 text-xl text-shadow-2xs
		sm:mx-auto
	"
	aria-label={text}
	id="slogan"
	transition:name="hero"
>
	<span aria-hidden="true">{Array.from(text).map(char => <span class="motion-char">{char}</span>)}</span>
</h1>

<script>
import { animate, stagger } from 'motion'

document.addEventListener('astro:page-load', () => {
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
		return
	animate('.motion-char', { opacity: [0, 1] }, {
		delay: stagger(0.025),
		duration: 0.3,
		ease: [0.23, 1, 0.32, 1],
	})
})
</script>
