---
interface Props {
	text?: string
}

const { text } = Astro.props;
---

<h2
	aria-label={text ?? 'I create clean design and build it to life'}
	class="px-4 pb-12 pt-4 text-shadow text-xl sm:w-xl sm:mx-auto"
	id="slogan"
>
	{
		text
			? (
					text.split('').map(char => <span class="motion-char">{char}</span>)
				)
			: (
					<>
						<span class="motion-char">I</span>
						<span class="motion-char"> </span>
						<span class="motion-char font-bold underline underline-offset-4 decoration-background/70 decoration-1">create</span>
						<span class="motion-char"> </span>
						<span class="motion-char">clean</span>
						<span class="motion-char"> </span>
						<span class="motion-char">design</span>
						<span class="motion-char"> </span>
						<span class="motion-char">and</span>
						<span class="motion-char"> </span>
						<span class="motion-char font-bold underline underline-offset-4 decoration-background/70 decoration-1">build</span>
						<span class="motion-char"> </span>
						<span class="motion-char">it</span>
						<span class="motion-char"> </span>
						<span class="motion-char">to</span>
						<span class="motion-char"> </span>
						<span class="motion-char">life</span>
					</>
				)
	}
</h2>

<script>
import { animate, delay, stagger } from 'motion'

document.addEventListener('astro:page-load', () => {
	delay(() => {
		animate(
			'.motion-char',
			{
				opacity: [0, 1],
				scale: [0.9, 1],
			},
			{
				delay: stagger(0.05),
			},
		)
	}, 1.2)
})
</script>
