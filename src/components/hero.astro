---
interface Props {
	text?: string
}

const { text } = Astro.props
---

<h2
	aria-label={text ?? 'I create clean design and build it to life'}
	class="px-4 pb-12 pt-4 text-shadow text-xl sm:w-2xl sm:mx-auto"
	id="slogan"
	transition:name="hero"
>
	{
		text
			? (
					text.split('').map(char => <span class="motion-char">{char}</span>)
				)
			: (
					<>
						<span class="motion-char">I</span>
						<span class="motion-char"> </span>
						<span class="motion-char font-bold underline underline-offset-4 decoration-brand-foreground/30 decoration-1">create</span>
						<span class="motion-char"> </span>
						<span class="motion-char">clean</span>
						<span class="motion-char"> </span>
						<span class="motion-char">design</span>
						<span class="motion-char"> </span>
						<span class="motion-char">and</span>
						<span class="motion-char"> </span>
						<span class="motion-char font-bold underline underline-offset-4 decoration-brand-foreground/30 decoration-1">build</span>
						<span class="motion-char"> </span>
						<span class="motion-char">it</span>
						<span class="motion-char"> </span>
						<span class="motion-char">to</span>
						<span class="motion-char"> </span>
						<span class="motion-char">life</span>
					</>
				)
	}
</h2>

<script>
import { animate, delay, stagger } from 'motion'

document.addEventListener('astro:page-load', () => {
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

	if (reducedMotion) {
		document.querySelectorAll('.motion-char').forEach((el) => {
			(el as HTMLElement).style.opacity = '1'
		})
		return
	}

	delay(() => {
		animate(
			'.motion-char',
			{
				opacity: [0, 1],
				scale: [0.9, 1],
			},
			{
				delay: stagger(0.05),
				ease: [0.23, 1, 0.32, 1],
			},
		)
	}, 0.5)
})
</script>
