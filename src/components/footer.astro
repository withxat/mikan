---
import { withBase } from '@/lib/urls'
import { siteConfig } from '@/site.config'
---

<footer
	class="
		z-10 flex w-full max-w-2xl flex-col py-4 text-sm
		sm:mx-auto
		print:opacity-100
	"
	transition:name="footer"
>
	<div class="flex flex-col gap-1 px-4 py-2">
		<p>&copy; {new Date().getFullYear()} {siteConfig.author}</p>
		<p>{siteConfig.description}</p>
	</div>
	{siteConfig.socials.length > 0 && (
		<nav aria-label="Social links" class="flex flex-wrap gap-x-4 gap-y-2 border-t border-dashed border-brand-foreground/50 px-4 py-2">
			{siteConfig.socials.map(social => (
				<a href={withBase(social.href)} rel={social.href.startsWith('https://') ? 'noopener noreferrer' : undefined} target={social.href.startsWith('https://') ? '_blank' : undefined}>{social.label}</a>
			))}
		</nav>
	)}
	<p class="border-t border-dashed border-brand-foreground/50 px-4 py-2">{siteConfig.footer}</p>
</footer>
