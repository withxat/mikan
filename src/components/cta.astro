---
import { cn } from '@/lib/utils'

interface Props {
	variant: 'contact' | 'navigate'
}

const { variant }: Props = Astro.props
---

<a href={variant === 'contact' ? 'mailto:i@xat.sh' : '/'} class={cn(
		'right-4 top-4 z-10',
		variant === 'contact' ? 'absolute' : 'fixed'
	)}>
	<button 
		class='btn-inner-shadow border border-brand rounded-sm px-2 py-1 text-sm inline-flex items-center gap-2 text-orange-700 bg-background'
	>
		{
			variant === 'contact' ? (
				<span class="i-mingcute-mail-line" />
			) : (
				<span class="i-mingcute-left-line" />
			)
		}
		{variant === 'contact' ? 'Get in touch' : 'Go to home'}
	</button>
</a>
