---
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
---

<div class="py-2">
	<div class="flex items-center justify-between my-3">
		<h3 class="font-bold text-brand leading-none tracking-wide ml-4 text-shadow-2xs">Project</h3>
		<a href="https://github.com/withxat" target="_blank">
			<button class="btn-inner-shadow cursor-pointer group/button flex items-center text-xs mr-2 px-2 py-1 rounded-sm bg-brand/15 sm:bg-none sm:hover:bg-brand/10 text-foreground/50">
				<span>View All</span>
				<span class="i-mingcute-arrow-right-line  w-4 ml-0.5 sm:ml-0 sm:w-0 sm:group-hover/button:w-4 sm:group-hover/button:ml-0.5 transition-all duration-200" />
			</button>
		</a>
	</div>
	<ul class="flex flex-col gap-1">
		{projects.map(project => (
			<li class="group/item mx-2 px-2 py-2 rounded-sm hover:bg-brand/10">
				<a href={project.data.link} target="_blank">
					<div class="flex items-center">
						<h4>{project.data.title}</h4>
						<span class="i-mingcute-arrow-right-up-line w-4 ml-1 sm:ml-0 sm:w-0 sm:group-hover/item:w-4 sm:group-hover/item:ml-1 transition-all duration-200" />
					</div>
					<p class="opacity-50 text-sm">{project.data.description}</p>
				</a>
			</li>
		))}
	</ul>
</div>
