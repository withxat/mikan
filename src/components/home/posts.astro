---
import { getCollection } from 'astro:content'

const posts = await getCollection('blog')

const latestPosts = posts.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()).slice(0, 2)
---

<div class="py-2">
	<div class="flex items-center justify-between my-3">
		<div class="inline-flex items-center gap-2">
			<h3 class="font-bold text-brand leading-none tracking-wide ml-4 text-shadow-2xs">Writing</h3>
			<a class="p-1" href="/feed.xml" aria-label="RSS Feed">
				<button class="btn-inner-shadow cursor-pointer group/button flex items-center text-xs mr-2 px-1 py-1 rounded-sm bg-brand text-brand-foreground">
					<span class="i-mingcute-rss-2-line text-sm leading-none" />
				</button>
			</a>
		</div>
		<a href="/post">
			<button class="btn-inner-shadow cursor-pointer group/button flex items-center text-xs mr-2 px-2 py-1 rounded-sm bg-brand text-brand-foreground">
				<span>View All</span>
				<span class="i-mingcute-arrow-right-line  w-4 ml-0.5 sm:ml-0 sm:w-0 sm:group-hover/button:w-4 sm:group-hover/button:ml-0.5 transition-all duration-200" />
			</button>
		</a>
	</div>
	<ul class="flex flex-col gap-1">
		{latestPosts.map(post => (
			<li class="mx-2 px-2 py-2 rounded-sm hover:bg-brand/10">
				<a href={`/post/${post.id}`}>
					<h4>{post.data.title}</h4>
					<p class="text-inactive text-sm">{post.data.summary}</p>
				</a>
			</li>
		))}
	</ul>
</div>
