---
import type { JSX } from 'astro/jsx-runtime'

import { cn } from '@/lib/utils'

type Props = JSX.IntrinsicElements['pre']

const { class: className, ...props } = Astro.props

---

<pre
	class={cn(
		'rounded-md border border-tertiary p-4',
		className,
	)}
	{...props}
><slot data-block="true" /></pre>
