---
import type { JSX } from 'astro/jsx-runtime'

import { cn } from '@/lib/utils'

type Props = JSX.IntrinsicElements['a']

const { class: className, ...props } = Astro.props
---

<a {...props} class={cn('text-link break-all', className)}><slot /></a>
<span class="i-mingcute-arrow-right-up-line text-tertiary translate-y-[3px] -translate-x-[2px]" />
