---
import type { JSX } from 'astro/jsx-runtime'

import { cn } from '@/lib/utils'

type Props = JSX.IntrinsicElements['a']

const { class: className, ...props } = Astro.props
---

<a {...props} class={cn('break-all text-link', className)}><slot /></a>
<span class="i-mingcute-arrow-right-up-line translate-x-[-2px] translate-y-[3px] text-tertiary" />
