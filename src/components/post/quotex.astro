---
import type { JSX } from 'astro/jsx-runtime'

import { cn } from '@/lib/utils'

type Props = JSX.IntrinsicElements['blockquote']

const { class: className, ...props } = Astro.props
---

<blockquote
	class={cn(
		'group/quote relative text-center',
		className,
	)}
	{...props}
>
	<span class="
		absolute -top-4 -left-4 i-mingcute-quote-left-fill size-10 bg-tertiary
		group-in-[blockquote]/quote:hidden
	"
	/>
	<slot />
	<span class="
		absolute -right-4 -bottom-4 i-mingcute-quote-right-fill size-10 bg-tertiary
		group-in-[blockquote]/quote:hidden
	"
	/>
</blockquote>
