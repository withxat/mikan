---
import type { JSX } from 'astro/jsx-runtime'

import { cn } from '@/lib/utils'

type Props = JSX.IntrinsicElements['blockquote']

const { class: className, ...props } = Astro.props
---

<blockquote
	class={cn(
		'text-center relative',
		className,
	)}
	{...props}
>
	<span class="absolute -left-4 -top-4 size-10 bg-tertiary i-mingcute-quote-left-fill" />
	<slot />
	<span class="absolute -right-4 -bottom-4 size-10 bg-tertiary i-mingcute-quote-right-fill" />
</blockquote>
