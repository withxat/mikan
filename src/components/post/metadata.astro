---
import { format } from 'date-fns'

interface Props {
	publishedAt: Date
	tags: string[]
}

const { publishedAt, tags }: Props = Astro.props
---

<div class="py-2 mx-4 flex flex-col gap-2 rounded-md bg-decoration border border-tertiary text-tertiary my-2">
	<h4 class="px-3 text-sm font-bold uppercase font-sans border-b mb-1">Metadata</h4>
	<div class="flex items-center px-3">
		<span class="basis-5/12 flex items-center gap-2">
			<span class="i-mingcute-calendar-fill" />
			<span class='text-secondary text-xs'>Published At</span>
		</span>
		<span class="text-xs text-secondary bg-white rounded-md px-2 py-1 border border-secondary/20">{format(publishedAt, 'yyyy-MM-dd')}</span>
	</div>
	<div class="flex items-center px-3">
		<span class="basis-5/12 flex items-center gap-2">
			<span class="i-mingcute-tag-fill" />
			<span class='text-secondary text-xs'>Tags</span>
		</span>
		<div class="flex items-center gap-2 flex-wrap">
			{tags.map((tag) => (
				<span class="text-xs text-white bg-secondary rounded-md px-2 py-1 border border-secondary/20">{tag}</span>
			))}
		</div>
	</div>
</div>
