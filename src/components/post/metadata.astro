---
interface Props {
	publishedAt: Date
	tags: string[]
}

const { publishedAt, tags }: Props = Astro.props
---

<div class="
	mx-4 my-2 flex flex-col gap-2 rounded-md border border-tertiary bg-decoration py-4
	text-tertiary
"
>
	<span class="mb-4 border-b px-4 font-sans text-base leading-none font-bold tracking-wide uppercase">PROPERTIES</span>
	<div class="flex w-full items-center px-4">
		<span class="flex basis-5/12 items-center gap-2 py-1">
			<span class="i-mingcute-calendar-fill" />
			<span class="text-xs text-secondary">Date</span>
		</span>
		<div class="basis-7/12">
			<time class="rounded-md border border-tertiary bg-surface px-2 py-1 text-xs text-secondary" datetime={publishedAt.toISOString()}>{publishedAt.toISOString().slice(0, 10)}</time>
		</div>
	</div>
	<div class="flex w-full items-start px-4">
		<span class="flex basis-5/12 items-center gap-2 py-1">
			<span class="i-mingcute-tag-fill" />
			<span class="text-xs text-secondary">Tags</span>
		</span>
		<div class="flex basis-7/12 flex-wrap items-center gap-2">
			{tags.map(tag => (
				<span class="rounded-md border border-tertiary bg-surface px-2 py-1 text-xs text-secondary">{tag}</span>
			))}
		</div>
	</div>
</div>
