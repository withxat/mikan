---
import { format } from 'date-fns'

interface Props {
	publishedAt: Date
	tags: string[]
}

const { publishedAt, tags }: Props = Astro.props
---

<div class="py-4 mx-4 flex flex-col gap-2 rounded-md bg-decoration border border-tertiary text-tertiary my-2">
	<span class="px-4 text-base leading-none font-bold uppercase font-sans border-b mb-4 tracking-wide">PROPERTIES</span>
	<div class="flex items-center px-4 w-full">
		<span class="basis-5/12 flex items-center gap-2 py-1">
			<span class="i-mingcute-calendar-fill" />
			<span class="text-secondary text-xs">Date</span>
		</span>
		<div class="basis-7/12">
			<span class="text-xs text-secondary bg-surface rounded-md px-2 py-1 border border-tertiary">{format(publishedAt, 'yyyy-MM-dd')}</span>
		</div>
	</div>
	<div class="flex items-start px-4 w-full">
		<span class="basis-5/12 flex items-center gap-2 py-1">
			<span class="i-mingcute-tag-fill" />
			<span class="text-secondary text-xs">Tags</span>
		</span>
		<div class="basis-7/12 flex items-center gap-2 flex-wrap">
			{tags.map(tag => (
				<span class="text-xs text-secondary rounded-md px-2 py-1 bg-surface border border-tertiary">{tag}</span>
			))}
		</div>
	</div>
</div>
