---
import type { ImageMetadata } from 'astro'

import { getImage } from 'astro:assets'

interface Props {
	alt?: string
	height?: number
	src: ImageMetadata | string
	title?: string
	width?: number
}

const { alt = '', height, src, title, width } = Astro.props
const image = await getImage({
	format: 'webp',
	height,
	inferSize: typeof src === 'string' && /^https?:\/\//.test(src),
	src,
	width,
})
---

<span class="flex flex-col gap-0.5">
	<a data-pswp-height={image.attributes.height} data-pswp-width={image.attributes.width} href={image.src} rel="noopener noreferrer" target="_blank">
		<img {...image.attributes} alt={alt} class="w-full" decoding="async" loading="lazy" src={image.src} />
	</a>
	{(title || alt) && <span class="mt-0 text-center text-sm leading-none text-inactive">{title ?? alt}</span>}
</span>
