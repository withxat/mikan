---
import type { ImageMetadata } from 'astro'

import { getImage, Image } from 'astro:assets'

interface Props {
	alt: string
	src: ImageMetadata | string
}

const { alt, src }: Props = Astro.props

const img = await getImage({
	densities: [0.7],
	format: 'webp',
	src,
})

---

<div class="flex flex-col gap-0.5">
	<a
		data-low-src={img.srcSet.values[0].url}
		data-pswp-height={img.attributes.height}
		data-pswp-width={img.attributes.width}
		href={img.src}
		target="_blank"
	>
		<Image alt={alt} class="w-full" height={img.srcSet.values[0].transform.height!} src={img.srcSet.values[0].url} width={img.srcSet.values[0].transform.width!} />
	</a>
	<span class="text-inactive text-sm text-center leading-none mt-0">{alt}</span>
</div>
