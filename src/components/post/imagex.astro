---
import type { ImageMetadata } from 'astro'

import { getImage, Image } from 'astro:assets'

interface Props {
	alt: string
	src: ImageMetadata | string
	title?: string
}

const { alt, src, title }: Props = Astro.props

const isExternal = typeof src === 'string' && src.startsWith('http')

const img = await getImage({
	densities: [0.7],
	format: 'webp',
	inferSize: isExternal,
	src,
})

const size = img.attributes

---

<div class="flex flex-col gap-0.5">
	<a
		data-low-src={img.srcSet.values[0].url}
		data-pswp-height={size.height}
		data-pswp-width={size.width}
		href={img.src}
		target="_blank"
	>
		<Image inferSize alt={alt} class="w-full" height={isExternal ? size.height : img.srcSet.values[0].transform.height!} src={isExternal ? src : img.srcSet.values[0].url} width={isExternal ? size.width : img.srcSet.values[0].transform.width!} />
	</a>
	<span class="text-inactive text-sm text-center leading-none mt-0">{title ?? alt}</span>
</div>
