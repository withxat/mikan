---
import Tag from '@/components/tag.astro'
import { siteConfig } from '@/site.config'

interface Props {
	tag?: string
}

const { tag } = Astro.props
---

<header
	class="
		mt-0.5 flex w-full max-w-2xl flex-col gap-1 p-4 text-3xl leading-none font-bold
		sm:mx-auto
	"
	id="header"
>
	<div class="flex items-center justify-between">
		<a aria-label={`${siteConfig.name} home`} class="inline-flex items-center gap-1 font-fugaz-one leading-none" href="/" transition:persist><span class="i-mingcute-sparkles-2-fill translate-y-[-2px] text-brand-foreground" />{siteConfig.name}</a>
	</div>
	<Tag tag={tag} />
</header>
