---
import { css } from '@/assets/font/fugaz-one.ttf'
import Tag from '@/components/tag.astro'

interface Props {
	tag?: string
}

const { tag } = Astro.props
---

<header
	class="flex flex-col gap-1 p-4 text-3xl leading-none font-bold sm:w-xl sm:mx-auto mt-0.5"
	id="header"
	transition:name="header"
>
	<h1 transition:persist class="leading-none inline-flex items-center gap-1" style={{ fontFamily: css.family }}><span class="i-mingcute-sparkles-2-fill text-brand-foreground -translate-y-[2px]" />Xat</h1>
	<Tag tag={tag} />
</header>
