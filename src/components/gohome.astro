<a
	transition:persist
	data-triggered="false"
	class="-right-30 top-4 z-20 fixed"
	href="/"
	id="gohome"
>
	<button
		class="btn-inner-shadow border border-brand rounded-md px-2 py-1 text-sm inline-flex items-center gap-2 text-secondary bg-background"
	>
		<span class="i-mingcute-left-line" />
		Go to home
	</button>
</a>

<script>
	import { animate, spring } from 'motion'

	document.addEventListener('astro:page-load', () => {
		if (document.querySelector('#gohome')!.getAttribute('data-triggered') === 'false') {
			animate('#gohome', {
				x: [0, -136],
			}, { delay: 0.5, duration: 0.5, type: spring })
			document.querySelector('#gohome')!.setAttribute('data-triggered', 'true')
		}
	})
</script>
