<a
	class="-right-30 top-4 z-20 fixed"
	data-triggered="false"
	href="/"
	id="gohome"
	transition:persist
>
	<button
		class="btn-inner-shadow border border-brand rounded-md px-2 py-1 text-sm inline-flex items-center gap-2 text-secondary bg-background"
	>
		<span class="i-mingcute-left-line" />
		Go to home
	</button>
</a>

<script>
import { animate, spring } from 'motion'

document.addEventListener('astro:page-load', () => {
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
	const el = document.querySelector('#gohome')!

	if (el.getAttribute('data-triggered') === 'false') {
		if (reducedMotion) {
			;(el as HTMLElement).style.transform = 'translateX(-136px)'
		}
		else {
			animate(el, {
				x: [0, -136],
			}, {
				delay: 1.5,
				duration: 0.5,
				type: spring,
			})
		}
		el.setAttribute('data-triggered', 'true')
	}
})
</script>
