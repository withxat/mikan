---
import LoadingIndicator from 'astro-loading-indicator/component'
import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

import { css } from '@/assets/font/calling-code.otf'
import Noise from '@/assets/noise.png'

import '@/styles/globals.css'

interface Props {
	description?: string
	tag?: string
	title?: string
}

const noise = await getImage({
	format: 'webp',
	src: Noise,
})

const { description, title } = Astro.props
---

<html lang="en">
	<head>
		<ClientRouter />
		<LoadingIndicator color="var(--secondary)" />
		<meta charset="UTF-8" />
		<link href="/sitemap-index.xml" rel="sitemap" />
		<script is:inline data-website-id="0b3c909d-3680-47f1-88f1-ae337236d0cd" src="https://cloud.umami.is/script.js" type="text/partytown"></script>
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<link
			href={new URL('feed.xml', Astro.site)}
			rel="alternate"
			title="Hi, Xat!"
			type="application/rss+xml"
		/>
		<title>
			{title ? `${title} - Xat` : 'Hi, Xat!'}
		</title>
		<meta content="summary_large_image" name="twitter:card" />
  <meta content="Hi, Xat!" name="twitter:title" />
		<meta content="https://xat.sh/og-image.png" property="og:image" />
		<meta content="Hi, Xat!" property="og:title" />
		<meta content={description ?? 'Code with Love, Exploring the World!'} property="og:description" />
		<meta content={description ?? 'Code with Love, Exploring the World!'} name="description" />
	</head>
	<body class="antialiased relative min-h-screen" style={{ fontFamily: `${css.family}, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", var(--font-sans)` }}>
		<div class="bg-brand absolute inset-0 -z-20" />
		<div class="absolute inset-0 -z-10" style={{ backgroundImage: `url(${noise.src})` }} />
		<slot />
	</body>
</html>

<script>
	import { animate, press } from 'motion'

	document.addEventListener('astro:page-load', () => {
		press('.pressable', (element) => {
			animate(element, {
				scale: 0.95,
			})

			return () => {
				animate(element, {
					scale: 1,
				})
			}
		})

		press('button', (element) => {
			animate(element, {
				scale: 0.95,
			})

			return () => {
				animate(element, {
					scale: 1,
				})
			}
		})
	})
</script>
