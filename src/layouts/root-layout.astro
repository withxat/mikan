---
import { Font, getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

import Noise from '@/assets/noise.png'

import '@/styles/globals.css'

interface Props {
	description?: string
	tag?: string
	title?: string
}

const noise = await getImage({
	format: 'webp',
	src: Noise,
})

const { description, title } = Astro.props
---

<html lang="en">
	<head>
		<Font cssVariable="--font-calling-code" />
		<Font cssVariable="--font-fugaz-one" />
		<ClientRouter />
		<meta charset="UTF-8" />
		<link href="/sitemap-index.xml" rel="sitemap" />
		<script data-website-id="0b3c909d-3680-47f1-88f1-ae337236d0cd" src="https://cloud.umami.is/script.js" type="text/partytown" is:inline></script>
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<link
			href={new URL('feed.xml', Astro.site)}
			rel="alternate"
			title="Hi, Xat!"
			type="application/rss+xml"
		/>
		<title>
			{title ? `${title} - Xat` : 'Hi, Xat!'}
		</title>
		<meta content="summary_large_image" name="twitter:card" />
		<meta content="Hi, Xat!" name="twitter:title" />
		<meta content="https://xat.sh/og-image.png" property="og:image" />
		<meta content="Hi, Xat!" property="og:title" />
		<meta content={description ?? 'Code with Love, Exploring the World!'} property="og:description" />
		<meta content={description ?? 'Code with Love, Exploring the World!'} name="description" />
	</head>
	<body class="antialiased relative min-h-screen font-mono">
		<div class="bg-brand absolute inset-0 -z-20" />
		<div class="absolute inset-0 -z-10 dark:invert" style={{ backgroundImage: `url(${noise.src})` }} />
		<slot />
	</body>
</html>

<script>
import { animate, press } from 'motion'

const easeOut = [0.23, 1, 0.32, 1] as const
const pressDown = { scale: 0.95 }
const pressUp = { scale: 1 }
const pressOpts = { duration: 0.15, easing: easeOut }

document.addEventListener('astro:page-load', () => {
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
	if (reducedMotion)
		return

	press('.pressable', (element) => {
		animate(element, pressDown, pressOpts)
		return () => {
			animate(element, pressUp, pressOpts)
		}
	})

	press('button', (element) => {
		animate(element, pressDown, pressOpts)
		return () => {
			animate(element, pressUp, pressOpts)
		}
	})
})
</script>
