---
import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

import Noise from '@/assets/noise.png'
import { absoluteUrl, withBase } from '@/lib/urls'
import { siteConfig } from '@/site.config'

import '@fontsource/fugaz-one/latin-400.css'
import '@/styles/globals.css'

interface Props {
	description?: string
	publishedAt?: Date
	title?: string
}

const noise = await getImage({ format: 'webp', src: Noise })
const { description = siteConfig.description, publishedAt, title } = Astro.props
const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.title
const canonical = new URL(Astro.url.pathname, siteConfig.url)
const ogImage = absoluteUrl(siteConfig.ogImage)
---

<html lang={siteConfig.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<ClientRouter />
		<link href={withBase('/favicon.svg')} rel="icon" type="image/svg+xml" />
		<link href={withBase('/sitemap-index.xml')} rel="sitemap" />
		<link href={canonical} rel="canonical" />
		<link href={absoluteUrl('/feed.xml')} rel="alternate" title={siteConfig.title} type="application/rss+xml" />
		<title>{pageTitle}</title>
		<meta content={description} name="description" />
		<meta content={siteConfig.author} name="author" />
		<meta content={publishedAt ? 'article' : 'website'} property="og:type" />
		<meta content={siteConfig.name} property="og:site_name" />
		<meta content={canonical} property="og:url" />
		<meta content={pageTitle} property="og:title" />
		<meta content={description} property="og:description" />
		<meta content={ogImage} property="og:image" />
		<meta content={siteConfig.name} property="og:image:alt" />
		<meta content="summary_large_image" name="twitter:card" />
		<meta content={pageTitle} name="twitter:title" />
		<meta content={description} name="twitter:description" />
		<meta content={ogImage} name="twitter:image" />
		{publishedAt && <meta content={publishedAt.toISOString()} property="article:published_time" />}
	</head>
	<body class="relative min-h-screen font-mono antialiased">
		<a
			class="
				sr-only
				focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:p-3 focus:text-foreground
			"
			href="#main-content"
		>Skip to content</a>
		<div class="absolute inset-0 -z-20 bg-brand"></div>
		<div
			class="
				absolute inset-0 -z-10
				dark:invert
			"
			style={{ backgroundImage: `url(${noise.src})` }}
		></div>
		<slot />
	</body>
</html>

<script>
import { animate, press } from 'motion'

let cleanup: (() => void) | undefined

document.addEventListener('astro:page-load', () => {
	cleanup?.()
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
		return
	cleanup = press('.pressable, button', (element) => {
		animate(element, { scale: 0.97 }, { duration: 0.15 })
		return () => {
			animate(element, { scale: 1 }, { duration: 0.15 })
		}
	})
})
document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
