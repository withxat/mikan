---
import { ClientRouter } from 'astro:transitions'

import { css } from '@/assets/font/calling-code.otf'
import Content from '@/components/content.astro'
import Footer from '@/components/footer.astro'
import Header from '@/components/header.astro'
import Hero from '@/components/hero.astro'

import '@/styles/globals.css'

interface Props {
	description?: string
	tag?: string
	title?: string
}

const { description, tag, title } = Astro.props
---

<html lang="en">
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<script data-website-id="0b3c909d-3680-47f1-88f1-ae337236d0cd" src="https://cloud.umami.is/script.js" type="text/partytown"></script>
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<link href="/favicon.ico" rel="icon" />
		<link href="/apple-touch-icon.png" rel="apple-touch-icon" />
		<link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
		<link href="/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png" />
		<link
			href={new URL('feed.xml', Astro.site)}
			rel="alternate"
			title="Hi, Xat!"
			type="application/rss+xml"
		/>
		<title>
			{title ? `${title} - Xat` : 'Hi, Xat!'}
		</title>
		<meta content={description ?? 'Code with Love, Exploring the World!'} name="description" />
	</head>
	<body class="antialiased relative" style={{ fontFamily: css.family }}>
		<div class="absolute inset-0 bg-[url('/image/noise.png')]" />
		<Header tag={tag} />
		<Hero text={title} />
		<Content>
			<slot />
		</Content>
		<Footer />
	</body>
</html>
