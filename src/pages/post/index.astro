---
import { getCollection } from 'astro:content'
import { format } from 'date-fns'

import PostLayout from '@/layouts/post-layout.astro'

const posts = await getCollection('blog')

const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())

const categories = await getCollection('categories')

const variousPosts = categories.flatMap((category) => {
	const posts = sortedPosts.filter(post => post.data.category === category.data.slug)
	if (posts.length > 0) {
		return {
			category,
			posts,
		}
	}
	return []
})
---

<PostLayout description="All writings written by Xat" tag="Archive - Texts just sparkle in my mind" title="All Writings">
	{variousPosts.map(category => (
		<div class="flex items-center justify-between my-3">
			<h3 class="font-bold text-brand leading-none tracking-wide ml-4 text-shadow-2xs">{category.category.data.name}</h3>
		</div>
		<ul class="py-2 flex flex-col gap-1">
			{category.posts.map(post => (
				<li class="mx-2 px-2 py-2 rounded-sm hover:bg-brand/10 relative pressable">
					<span class="absolute top-2 right-2 inset-shadow-2xs text-inactive text-xs border i px-1.5 py-0.5 rounded-sm bg-brand/10">{format(post.data.date, 'yyyy-MM-dd')}</span>
					<a href={`/post/${post.id}`}>
						<h4>{post.data.title}</h4>
						<p class="text-inactive text-sm">{post.data.summary}</p>
						<div class="flex items-center gap-2">
							{post.data.tags.map(tag => (
								<span class="text-xs">#{tag}</span>
							))}
						</div>
					</a>
				</li>
			))}
		</ul>
	))}
</PostLayout>
