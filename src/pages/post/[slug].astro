---
import { getCollection, getEntry, render } from 'astro:content'

import CodeBlockx from '@/components/post/codeblockx.astro'
import Imagex from '@/components/post/imagex.astro'
import Linkx from '@/components/post/linkx.astro'
import Metadata from '@/components/post/metadata.astro'
import Quotex from '@/components/post/quotex.astro'
import PostLayout from '@/layouts/post-layout.astro'
import { publishedPosts } from '@/lib/posts'
import { withBase } from '@/lib/urls'
import { cn } from '@/lib/utils'

export async function getStaticPaths() {
	const posts = publishedPosts(await getCollection('blog'))
	return posts.map(post => ({
		params: { slug: post.id },
	}))
}

const { slug } = Astro.params
const post = await getEntry('blog', slug)

if (!post) {
	Astro.redirect(withBase('/post'))
	return
}

const category = await getEntry(post.data.category)

if (!category) {
	throw new Error(`Unknown category for post "${post.id}". Add it to contents/categories.json.`)
}

const { Content } = await render(post);
---

<PostLayout
	description={post.data.summary}
	publishedAt={post.data.date}
	tag={`${category.data.name} - ${category.data.description}`}
	title={post.data.title}
>
	<Metadata publishedAt={post.data.date} tags={post.data.tags} />
	<div
		class={cn(
			`
				mx-4 prose max-w-full py-2 font-sans
				*:hyphens-auto
				dark:prose-invert
			`,
			'prose-img:mt-0 prose-img:mb-2 prose-img:rounded-sm prose-img:border',
			`
				prose-code:font-mono prose-code:break-all
				prose-code:before:hidden
				prose-code:after:hidden
			`,
			'prose-code:not-[:where(pre_code)]:mx-0.5 prose-code:not-[:where(pre_code)]:rounded-sm prose-code:not-[:where(pre_code)]:bg-decoration prose-code:not-[:where(pre_code)]:px-1.5 prose-code:not-[:where(pre_code)]:pt-0.75 prose-code:not-[:where(pre_code)]:pb-0.5 prose-code:not-[:where(pre_code)]:text-[15px] prose-code:not-[:where(pre_code)]:font-normal prose-code:not-[:where(pre_code)]:text-secondary',
			'prose-a:text-link prose-a:underline prose-a:decoration-link-decoration prose-a:decoration-1 prose-a:underline-offset-4',
			'prose-p:hyphens-auto',
			'prose-headings:not-first:mt-[1.5em] prose-headings:not-first:mb-[1em] prose-headings:not-first:scroll-mt-[1em]',
			'prose-h2:text-[1.725rem] prose-h2:font-bold prose-h2:text-secondary',
			'prose-h3:text-[1.125rem] prose-h3:font-bold',
			`
				prose-blockquote:rounded-sm prose-blockquote:border-l-0 prose-blockquote:bg-decoration prose-blockquote:px-4 prose-blockquote:py-2 prose-blockquote:text-base prose-blockquote:font-medium
				prose-blockquote:*:before:content-none
				prose-blockquote:*:after:content-none
			`,
		)}
		id="post"
	>
		{
			post && (
				<Content
					components={{
						a: Linkx,
						blockquote: Quotex,
						img: Imagex,
						pre: CodeBlockx,
					}}
				/>
			)
		}
	</div>
</PostLayout>

<script>
import { animate, inView } from 'motion'

document.addEventListener('astro:page-load', () => {
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
		return
	inView('#post img', (element) => {
		animate(
			element,
			{
				opacity: [0, 1],
				scale: [0.9, 1],
				y: [10, 0],
			},
			{
				delay: 0.2,
			},
		)
	})
})
</script>

<script>
import PhotoSwipeLightbox from 'photoswipe/lightbox'

import 'photoswipe/style.css'

const lightbox = new PhotoSwipeLightbox({
	bgOpacity: 0.8,
	close: true,
	gallery: '#post a:has(img)',
	imageClickAction: 'close',
	mainClass: 'lightbox',
	padding: {
		bottom: 10,
		left: 10,
		right: 10,
		top: 10,
	},
	pswpModule: () => import('photoswipe'),
	tapAction: 'close',
	zoom: false,
})

lightbox.addFilter('domItemData', (itemData, _, linkEl) => {
	const lowSrc = linkEl.getAttribute('data-low-src')
	if (lowSrc) {
		itemData.msrc = lowSrc
	}
	return itemData
})

document.addEventListener('astro:page-load', () => {
	lightbox.init()
})

document.addEventListener('astro:before-swap', () => {
	lightbox.destroy()
})
</script>
