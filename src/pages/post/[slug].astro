---
import { getCollection, getEntry, render } from 'astro:content'

import { css } from '@/assets/font/calling-code.otf'
import Imagex from '@/components/post/imagex.astro'
import Linkx from '@/components/post/linkx.astro'
import Metadata from '@/components/post/metadata.astro'
import PostLayout from '@/layouts/post-layout.astro'
import { cn } from '@/lib/utils'

export async function getStaticPaths() {
	const posts = await getCollection('blog')
	return posts.map(post => ({
		params: { slug: post.id },
	}))
}

const { slug } = Astro.params
const post = await getEntry('blog', slug)

if (!post) {
	Astro.redirect('/post')
	return
}

const category = await getEntry('categories', post.data.category)

if (!category) {
	Astro.redirect('/post')
	return
}

const { Content } = await render(post)
---

<PostLayout description={post.data.summary} tag={`${category.data.name} - ${category.data.description}`} title={post.data.title}>
	<Metadata publishedAt={post.data.publishedAt} tags={post.data.tags} />
	<div
		class={cn(
			'prose py-2 mx-4 font-sans',
			'prose-img:opacity-0 print:prose-img:opacity-100 prose-img:mt-0 prose-img:mb-2 prose-img:rounded-sm prose-img:border',
			'prose-code:before:hidden prose-code:after:hidden prose-code:bg-decoration prose-code:rounded-sm prose-code:px-1.5 prose-code:text-base prose-code:text-secondary prose-code:py-0.5 prose-code:mx-0.5',
			'prose-a:text-secondary prose-a:underline prose-a:underline-offset-4 prose-a:decoration-tertiary prose-a:decoration-1',
			'prose-p:hyphens-auto',
			'prose-headings:mt-[1.5em] prose-headings:scroll-mt-[1em] prose-headings:mb-[1em]',
			'prose-h2:text-secondary prose-h2:font-bold prose-h2:text-[1.725rem]',
			'prose-h3:font-bold prose-h3:text-[1.125rem]',
		)}
		style={{
			'--default-mono-font-family': css.family,
		}}
		id="post"
	>
		{post && (
			<Content components={{ a: Linkx, img: Imagex }} />
		)}
	</div>
</PostLayout>

<script>
	import { animate, inView } from 'motion'

	document.addEventListener('astro:page-load', () => {
		inView('#post img', (element) => {
			animate(element, {
				filter: ['blur(4px)', 'none'],
				opacity: [0, 1],
				scale: [0.9, 1],
				y: [10, 0],
			}, {
				delay: 0.2,
			})
		})
	})
</script>

<script>
import PhotoSwipeLightbox from 'photoswipe/lightbox'

import 'photoswipe/style.css'

const lightbox = new PhotoSwipeLightbox({
	bgOpacity: 0.8,
	close: false,
	gallery: '#post a:has(img)',
	imageClickAction: 'close',
	mainClass: 'lightbox',
	padding: {
		bottom: 10,
		left: 10,
		right: 10,
		top: 10,
	},
	pswpModule: () => import('photoswipe'),
	tapAction: 'close',
	zoom: false,
})

lightbox.addFilter('domItemData', (itemData, _, linkEl) => {
	const lowSrc = linkEl.getAttribute('data-low-src')
	if (lowSrc) {
		itemData.msrc = lowSrc
	}
	return itemData
})

document.addEventListener('astro:page-load', () => {
	lightbox.init()
})

document.addEventListener('astro:before-swap', () => {
	lightbox.destroy()
})
</script>
