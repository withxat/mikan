---
import { getCollection, getEntry, render } from 'astro:content'
import { cn } from '@/lib/utils'
import Imagex from '@/components/post/imagex.astro'
import Metadata from '@/components/post/metadata.astro'
import PostLayout from '@/layouts/post-layout.astro'

export async function getStaticPaths() {
	const posts = await getCollection('blog')
	return posts.map(post => ({
		params: { slug: post.id },
	}))
}

const { slug } = Astro.params
const post = await getEntry('blog', slug)

if (!post) {
	Astro.redirect('/post')
	return
}

const category = await getEntry('categories', post.data.category)

if (!category) {
	Astro.redirect('/post')
	return
}

const { Content } = await render(post)
---

<PostLayout description={post.data.summary} tag={`${category.data.name} - ${category.data.description}`} title={post.data.title}>
	<Metadata publishedAt={post.data.publishedAt} tags={post.data.tags} />
	<div class={cn(
		'prose font-sans py-2 mx-4',
		'prose-img:opacity-0 print:prose-img:opacity-100 prose-img:mt-0 prose-img:mb-2',
		'prose-code:before:hidden prose-code:after:hidden prose-code:bg-decoration prose-code:rounded-sm prose-code:px-1.5 prose-code:text-xs prose-code:text-secondary prose-code:py-0.5 prose-code:mx-0.5'
	)} id="post">
		{post && (
			<Content components={{ img: Imagex }} />
		)}
	</div>
</PostLayout>

<script>
	import { animate, inView } from 'motion'

	document.addEventListener('astro:page-load', () => {
		inView('#post img', (element) => {
			animate(element, {
				filter: ['blur(4px)', 'none'],
				opacity: [0, 1],
				scale: [0.9, 1],
				y: [10, 0],
			}, {
				delay: 0.2,
			})
		})
	})
</script>

<script>
import PhotoSwipeLightbox from 'photoswipe/lightbox'

import 'photoswipe/style.css'

const lightbox = new PhotoSwipeLightbox({
	bgOpacity: 0.8,
	close: false,
	gallery: '#post a:has(img)',
	mainClass: 'lightbox',
	padding: {
		bottom: 10,
		left: 10,
		right: 10,
		top: 10,
	},
	pswpModule: () => import('photoswipe'),
	tapAction: 'close',
	zoom: false,
})

lightbox.addFilter('domItemData', (itemData, _, linkEl) => {
	const lowSrc = linkEl.getAttribute('data-low-src')
	if (lowSrc) {
		itemData.msrc = lowSrc
	}
	console.log(itemData)
	return itemData
})

document.addEventListener('astro:page-load', () => {
	lightbox.init()
})

document.addEventListener('astro:before-swap', () => {
	lightbox.destroy()
})
</script>
