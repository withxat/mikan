---
import { getCollection, getEntry, render } from 'astro:content'

import Imagex from '@/components/post/imagex.astro'
import RootLayout from '@/layouts/root-layout.astro'

export async function getStaticPaths() {
	const posts = await getCollection('blog')
	return posts.map(post => ({
		params: { slug: post.id },
	}))
}

const { slug } = Astro.params
const post = await getEntry('blog', slug)

if (!post) {
	Astro.redirect('/post')
	return
}

const category = await getEntry('categories', post.data.category)

if (!category) {
	Astro.redirect('/post')
	return
}

const { Content } = await render(post)
---

<RootLayout description={post.data.summary} tag={`${category.data.name} - ${category.data.description}`} title={post.data.title}>
	<div class="prose font-sans py-2 mx-4 prose-img:opacity-0 print:prose-img:opacity-100" id="post">
		{post && (
			<Content components={{ img: Imagex }} />
		)}
	</div>
</RootLayout>

<script>
	import { animate, inView } from 'motion'

	document.addEventListener('astro:page-load', () => {
		inView('#post img', (element) => {
			animate(element, {
				filter: ['blur(4px)', 'none'],
				opacity: [0, 1],
				scale: [0.9, 1],
				y: [10, 0],
			}, {
				delay: 0.2,
			})
		})
	})
</script>

<script>
import { animate } from 'motion'
import PhotoSwipeLightbox from 'photoswipe/lightbox'

import 'photoswipe/style.css'

const lightbox = new PhotoSwipeLightbox({
	bgOpacity: 0.5,
	close: false,
	gallery: '#post a',
	mainClass: 'lightbox',
	padding: {
		bottom: 10,
		left: 10,
		right: 10,
		top: 10,
	},
	pswpModule: () => import('photoswipe'),
	zoom: false,
})

document.addEventListener('astro:page-load', () => {
	lightbox.init()
	animate('.lightbox', {
		backdropFilter: 'blur(4px)',
	}, {
		duration: 0.2,
	})
})

document.addEventListener('astro:before-swap', () => {
	lightbox.destroy()
})
</script>
